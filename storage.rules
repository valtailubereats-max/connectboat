rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "valtailubereats@gmail.com" ||
        request.auth.token.email == "valtail@gmail.com" ||
        request.auth.token.email == "generalsales2021@gmail.com"
      );
    }

    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /temporary-listing-videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /listing-videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /showcases/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /marketing/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photo_store/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /advertising/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
