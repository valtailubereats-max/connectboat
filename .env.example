# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ConnectBoat Automated Transactional Email System (Resend)
# Set RESEND_API_KEY to send production emails via Resend.
# If omitted, system safely logs clean simulation entries in server output.
RESEND_API_KEY=""
EMAIL_FROM="ConnectBoat <no-reply@connectboat.co.uk>"
EMAIL_REPLY_TO="contato@connectboat.co.uk"

# Stripe Integration Credentials
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# GA4 Measurement Protocol: keep the API secret server-side only.
GA4_MEASUREMENT_ID="G-B0BPV9R463"
GA4_API_SECRET=""

# Event Contacts: server-only configuration; use the same secret in Apps Script properties.
EVENT_CONTACTS_SYNC_SECRET=
EVENT_CONTACTS_SHEETS_URL=
