rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.email == "valtailubereats@gmail.com" ||
          request.auth.token.email == "valtail@gmail.com" ||
          request.auth.token.email == "generalsales2021@gmail.com" ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
          )
        );
    }

    function isFinanceOwner() {
      return isAuthenticated() &&
        (
          request.auth.token.email == "valtailubereats@gmail.com" ||
          request.auth.token.email == "valtail@gmail.com" ||
          request.auth.token.email == "generalsales2021@gmail.com"
        );
    }

    function isModerator() {
      return isAuthenticated() &&
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'moderator'
        );
    }

    function isContentCreator() {
      return isAuthenticated() &&
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'content_creator'
        );
    }

    function isValidUser(data, userId) {
      return (!('uid' in data) || data.uid == userId) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() < 100)) &&
             (!('email' in data) || data.email is string) &&
             (!('role' in data) || data.role in ['user', 'admin', 'moderator', 'content_creator']) &&
             (!('financeAccess' in data) || data.financeAccess is bool) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('acceptedTerms' in data) || data.acceptedTerms is bool) &&
             (!('acceptedTermsAt' in data) || data.acceptedTermsAt is timestamp || data.acceptedTermsAt is string) &&
             (!('referralCredits' in data) || data.referralCredits is number) &&
             (!('pointsFromAds' in data) || data.pointsFromAds is number) &&
             (!('referredUsersCount' in data) || data.referredUsersCount is number) &&
             (!('referralCode' in data) || data.referralCode is string);
    }

    function isValidAd(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'imageUrl', 'city', 'category', 'sellerId', 'sellerPhone', 'sellerName', 'status', 'createdAt']) &&
             data.id is string &&
             data.title is string &&
             data.description is string &&
             data.imageUrl is string &&
             data.city is string &&
             data.category is string &&
             data.sellerId == request.auth.uid &&
             data.sellerPhone is string &&
             data.sellerName is string &&
             data.status in ['pending', 'approved', 'rejected', 'expired', 'archived', 'sold'] &&
             (!('adStatus' in data) || data.adStatus in ['active', 'near_expiration', 'expired', 'archived', 'sold']) &&
             (!('listingType' in data) || data.listingType in ['normal', 'informativo']) &&
             (!('listingType' in data) || data.listingType == 'normal' || isAdmin()) &&
             (!('targetUrl' in data) || data.targetUrl == '' || data.targetUrl == null || isAdmin()) &&
             (!('serviceCoverage' in data) || data.serviceCoverage in ['city', 'radius20', 'radius50', 'county', 'uk', 'portugal', 'online']) &&
             data.createdAt is timestamp;
    }

    function isValidAdImagesAndPlan(data) {
      let isFeaturedAd = data.get('isFeatured', false) == true || data.get('plan', 'free') in ['featured', 'highlight', 'local', 'national', 'intermediate', 'premium'];
      let imagesList = data.get('images', []);
      return imagesList is list &&
             (isFeaturedAd ? (imagesList.size() <= 10) : (imagesList.size() <= 6));
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['id', 'planDurations', 'expirationAction
